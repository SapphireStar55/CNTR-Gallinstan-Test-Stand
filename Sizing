function s = pass_fail(cond)
    if cond; s = '✓ PASS'; else; s = '✗ FAIL'; end
end

function v = iif(cond, a, b)
    if cond; v = a; else; v = b; end
end

function t = endcap_thickness_fn(etype, P, R, Sa, Ej)
    switch lower(etype)
        case 'flat';          t = 2*R * 0.33 * sqrt(P/Sa);
        case 'ellipsoidal';   t = (P*2*R) / (2*Sa*Ej - 0.2*P);
        case 'hemispherical'; t = (P*R)   / (2*Sa*Ej - 0.2*P);
        otherwise;            t = (P*2*R) / (2*Sa*Ej - 0.2*P);
    end
end
