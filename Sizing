%% Gallinstan Pressure Vessel — Forward Sizing Calculator
% Inputs:  operating conditions + material + target safety factors
% Outputs: required dimensions driven by correct governing loads
%
%   The SiC plate rests on shoulders on both sides and is clamped via bolt preload; on
%   heating, the steel structure between the shoulders grows faster than
%   the SiC plate (alpha_steel = 17.2e-6/K vs alpha_SiC = 4.0e-6/K), so
%   free thermal expansion alone does not compress the plate — closing
%   the assembly gap and maintaining clamp force is a bolt-preload /
%   joint-stiffness problem, not a rigid-bond CTE-mismatch problem. That
%   preload/joint-diagram analysis is NOT modeled here and should be
%   handled separately (or in FEA) if clamp-force retention across the
%   operating temperature range needs to be verified.
%
%   The SiC plate is now sized purely as a CLAMPED CIRCULAR PLATE under
%   uniform pressure. The vessel wall and end caps are sized by ASME
%   pressure-only formulas.
%
% PROPERTY VALUES CORRECTED vs literature (see gallinstan_input_validation.m):
%   alpha_vessel : 17.0e-6 → 17.2e-6 1/K   (ASME IID, 316L at 200°C) — kept
%                  for reference only; NOT used in stress calcs anymore.
%   Sy_vessel    : 170e6   confirmed         (ASME IID mid-range)
%   E_SiC        : 410e9   confirmed         (sintered α-SiC)
%   MOR_SiC      : 370e6   confirmed but GRADE-SENSITIVE — see note below
%   alpha_SiC    : 4.0e-6  confirmed         (sintered α-SiC) — reference only
%
% KEY DESIGN PHILOSOPHY:
%   - At P_op ≈ 2500 Pa, pressure stress is negligible in the WALL/CAPS
%     relative to material strength — practical manufacturing minimums
%     govern wall and end cap thickness, not the ASME formulas.
%   - The SiC plate is the one component where pressure-driven bending
%     is still the real governing load (ceramics are stress-limited, not
%     just strain-limited like ductile steel).
%   - SF applied via allowable stress — not via pressure amplification.

% =========================================================================
clear; clc; close all;

%% ===================================================================
%  >>>  USER INPUTS
%% ===================================================================

P_operating   = 2500;          % Peak operating pressure [Pa]
T_ambient     = 20;            % Assembly temperature [°C]  (reference only)
T_operating   = 200;           % Operating temperature [°C] (reference only)

SF_vessel     = 3.0;           % Target SF vs yield — vessel (pressure)
SF_SiC        = 3.0;           % Target SF vs MOR  — SiC plate (bending)
SF_bolt       = 2.0;           % Target SF vs yield — bolts

R_inner       = 0.25;         % Inner vessel radius [m]  (25 mm)
L_vessel      = 1.00;         % Vessel length [m]        (150 mm)
endcap_type   = 'ellipsoidal'; % 'flat' | 'ellipsoidal' | 'hemispherical'
SiC_edge_BC   = 'clamped';     % 'clamped' | 'simply_supported'

% --- 316L Stainless Steel at 200°C  (ASME Section II Part D) ---
mat_v.name    = '316L Stainless Steel';
mat_v.E       = 193e9;         % [Pa]
mat_v.nu      = 0.28;
mat_v.alpha   = 17.2e-6;       % [1/K]  reference only — not used in stress calc
mat_v.Sy      = 170e6;         % [Pa]   yield at 200°C
mat_v.Su      = 450e6;         % [Pa]   UTS at 200°C
mat_v.rho     = 7950;          % [kg/m³]

% --- SiC (sintered α-SiC — Munro 1997 / manufacturer datasheets) ---
% ⚠  MOR is GRADE-SENSITIVE:
%    Sintered α-SiC :  300–500 MPa  (use 370 MPa as mid-range)
%    Reaction-bonded:  200–350 MPa  (lower; contains residual Si)
%    Hot-pressed     :  400–700 MPa  (highest; expensive)
% Use the value from your specific supplier's datasheet for final sizing.
mat_s.name    = 'Sintered alpha-SiC';
mat_s.E       = 370e9;         % [Pa]   confirmed in range 370–450 GPa
mat_s.nu      = 0.14;          % [-]    confirmed in range 0.14–0.21
mat_s.alpha   = 4.0e-6;        % [1/K]  reference only — not used in stress calc
mat_s.MOR     = 370e6;         % [Pa]   sintered mid-range; use 300e6 for RB-SiC
mat_s.KIC     = 3.5e6;         % [Pa√m] confirmed in range 2.5–4.5

% --- Bolt material (ASTM A193 B8M = 316SS bolting) ---
mat_b.name    = 'ASTM A193 B8M (316SS)';
mat_b.Sy      = 207e6;         % [Pa]
bolt_dia      = 0.010;         % [m]  M10

% --- Gasket (PTFE — compatible with Galinstan, rated to 260°C) ---
gasket_width  = 0.005;         % [m]
m_gasket      = 2.0;           % gasket factor (ASME App.2)
y_gasket      = 11.0e6;        % min seating stress [Pa]
t_gasket      = 0.002;         % [m]

% --- Manufacturing minimums ---
t_wall_min    = 0.05;         % [m]  50 mm — weldability / LME margin
t_endcap_min  = 0.04;         % [m]  40 mm

%% ===================================================================
%  DERIVED QUANTITIES
%% ===================================================================

E_joint     = 1.0;                           % weld efficiency (full-pen)
a_plate     = R_inner;                       % SiC plate radius [m]

S_allow_v   = mat_v.Sy / SF_vessel;
S_allow_SiC = mat_s.MOR / SF_SiC;
S_allow_bolt= mat_b.Sy / SF_bolt;

%% ===================================================================
%  LOAD HIERARCHY PRINTOUT
%% ===================================================================

fprintf('=========================================================\n');
fprintf('  LOAD HIERARCHY — GOVERNING STRESS DRIVERS\n');
fprintf('=========================================================\n');
t_demo = t_wall_min;
sig_hoop_demo = P_operating * R_inner / t_demo;
fprintf('Operating pressure : %.0f Pa  (%.5f bar)\n', P_operating, P_operating/1e5);
fprintf('Hoop stress in %.0f mm wall : %.4f MPa  (SF_pressure = %.0f×)\n', ...
        t_demo*1e3, sig_hoop_demo/1e6, mat_v.Sy/sig_hoop_demo);
fprintf('→ Pressure is far below yield/MOR for the wall and end caps —\n');
fprintf('  those components are sized by PRACTICAL MANUFACTURING MINIMUMS,\n');
fprintf('  not by the ASME pressure formulas (see sections A and C).\n\n');
fprintf('→ The SiC plate is the one component where pressure-driven\n');
fprintf('  bending is still the real governing load, since ceramics are\n');
fprintf('  stress-limited.\n');
fprintf('  from this version — the plate floats radially and is clamped\n');
fprintf('  axially by bolt preload on both shoulders; see revision note\n');
fprintf('  at top of script for why that is a joint-preload problem, not\n');
fprintf('  a rigid-bond thermal stress problem, and is not modeled here.\n\n');

fprintf('⚠  MATERIAL COMPATIBILITY (316L SS + Galinstan):\n');
fprintf('   Gallium alloys cause liquid metal embrittlement (LME) in SS at 200°C.\n');
fprintf('   Consider: SiC/PTFE liner, Hastelloy C-276, or tungsten wetted surfaces.\n\n');

%% ===================================================================
%  A) CYLINDER WALL SIZING
%% ===================================================================

t_ASME = (P_operating * R_inner) / (S_allow_v * E_joint - 0.6*P_operating);

t_wall     = max(t_ASME, t_wall_min);
t_wall_nom = ceil(t_wall * 2000) / 2000;

R_outer  = R_inner + t_wall_nom;

sig_hoop  = P_operating * R_inner / t_wall_nom;
sig_axial = P_operating * R_inner / (2*t_wall_nom);
sig_vm_P  = sqrt(sig_hoop^2 + sig_axial^2 - sig_hoop*sig_axial);

SF_wall_P  = mat_v.Sy / sig_vm_P;

fprintf('=========================================================\n');
fprintf('  A) CYLINDER WALL SIZING\n');
fprintf('=========================================================\n');
fprintf('ASME Div.1 min thickness      : %.4f mm  (pressure only)\n', t_ASME*1e3);
fprintf('Practical manufacturing min   : %.1f mm\n', t_wall_min*1e3);
fprintf('Governing                     : %s\n', ...
        iif(t_ASME > t_wall_min,'ASME formula','Practical minimum'));
fprintf('Nominal wall thickness  ★     : %.1f mm  ← USE THIS\n\n', t_wall_nom*1e3);
fprintf('Stress verification:\n');
fprintf('  Hoop (pressure)             : %.5f MPa\n', sig_hoop/1e6);
fprintf('  Von Mises (pressure)        : %.5f MPa  → SF = %.0f×  %s\n\n', ...
        sig_vm_P/1e6, SF_wall_P, pass_fail(SF_wall_P >= SF_vessel));

%% ===================================================================
%  B) SiC PLATE SIZING  —  PRIMARY GOVERNING COMPONENT
%%    Clamped (or simply supported) circular plate, pressure only.
%%    (OD clearance) and any axial thermal effect is governed by bolt
%%    preload / joint stiffness, not modeled here.
%% ===================================================================

if strcmp(SiC_edge_BC,'clamped')
    C_bend = (3*P_operating*a_plate^2) / 4;
else
    C_bend = (3*(3+mat_s.nu)*P_operating*a_plate^2) / 8;
end

t_SiC     = sqrt(C_bend / S_allow_SiC);
t_SiC_nom = ceil(t_SiC * 1000) / 1000;

D_plate      = (mat_s.E * t_SiC_nom^3) / (12*(1-mat_s.nu^2));
sig_bend_nom = C_bend / t_SiC_nom^2;
SF_SiC_bend  = mat_s.MOR / sig_bend_nom;

if strcmp(SiC_edge_BC,'clamped')
    w_max = (P_operating*a_plate^4) / (64*D_plate);
else
    w_max = (5*(3+mat_s.nu)*P_operating*a_plate^4) / (64*(1+mat_s.nu)*D_plate);
end

Y_geo  = 1.12;
a_crit = (1/pi) * (mat_s.KIC / (sig_bend_nom*Y_geo))^2;

fprintf('=========================================================\n');
fprintf('  B) SiC PLATE SIZING  ★ PRIMARY GOVERNING COMPONENT\n');
fprintf('     (%s edge, pressure-driven bending only)\n', upper(SiC_edge_BC));
fprintf('=========================================================\n');
fprintf('MOR (sintered α-SiC)      : %.0f MPa  [use %.0f MPa for RB-SiC —\n', ...
        mat_s.MOR/1e6, 300);
fprintf('                             confirm against your supplier datasheet]\n');
fprintf('Allowable (MOR/SF)        : %.2f MPa\n\n', S_allow_SiC/1e6);
fprintf('Thickness from bending    : %.3f mm\n', t_SiC*1e3);
fprintf('Nominal (↑ to mm) ★       : %.0f mm  ← USE THIS\n\n', t_SiC_nom*1e3);
fprintf('Verification at %.0f mm:\n', t_SiC_nom*1e3);
fprintf('  Bending stress          : %.4f MPa\n', sig_bend_nom/1e6);
fprintf('  SF (bending)            : %.2f×  %s\n', SF_SiC_bend, pass_fail(SF_SiC_bend>=SF_SiC));
fprintf('  Max deflection          : %.6f mm\n', w_max*1e3);
fprintf('  w/t                     : %.6f  (%s)\n', w_max/t_SiC_nom, ...
        iif(w_max/t_SiC_nom<0.2,'linear plate theory valid ✓','use nonlinear FEA'));
fprintf('  Critical flaw size      : %.3f mm  ← specify surface finish to this tolerance\n\n', a_crit*1e3);

%% ===================================================================
%  C) END CAP SIZING
%% ===================================================================

t_cap_ASME = endcap_thickness_fn(endcap_type, P_operating, R_inner, S_allow_v, E_joint);
t_cap      = max(t_cap_ASME, t_endcap_min);
t_cap_nom  = ceil(t_cap * 2000) / 2000;

sig_cap_P = P_operating * R_inner / t_cap_nom;
SF_cap    = mat_v.Sy / sig_cap_P;

fprintf('=========================================================\n');
fprintf('  C) END CAP SIZING  (%s)\n', endcap_type);
fprintf('=========================================================\n');
fprintf('ASME formula min          : %.6f mm\n', t_cap_ASME*1e3);
fprintf('Practical min             : %.1f mm\n', t_endcap_min*1e3);
fprintf('Governing                 : %s\n', ...
        iif(t_cap_ASME > t_endcap_min, 'ASME formula', 'Practical minimum'));
fprintf('Nominal thickness ★       : %.1f mm  ← USE THIS\n', t_cap_nom*1e3);
fprintf('Pressure stress           : %.5f MPa\n', sig_cap_P/1e6);
fprintf('SF (pressure)             : %.2f×  %s\n\n', SF_cap, pass_fail(SF_cap>=SF_vessel));
fprintf('NOTE: at this pressure the ASME formula is far below the\n');
fprintf('practical minimum, so t_endcap_min effectively sets this\n');
fprintf('dimension directly (rounded up to the nearest 0.5 mm). Changing\n');
fprintf('pressure, radius, or SF will not move this number unless\n');
fprintf('t_endcap_min itself is changed, or pressure rises by orders of\n');
fprintf('magnitude.\n\n');

%% ===================================================================
%  D) FLANGE & BOLT SIZING
%% ===================================================================

A_gasket = pi*((R_inner+gasket_width)^2 - R_inner^2);
W_seat   = y_gasket * A_gasket;
W_op     = P_operating*pi*R_inner^2 + 2*m_gasket*P_operating*A_gasket;
W_bolts  = max(W_seat, W_op);
governs  = iif(W_seat > W_op, 'GASKET SEATING (typical at low P)', 'OPERATING LOAD');

A_bolt   = 0.8*(pi/4)*bolt_dia^2;
n_req    = ceil(W_bolts / (A_bolt*S_allow_bolt));
n_nom    = ceil(n_req/4)*4;

sig_bolt    = W_bolts / (n_nom*A_bolt);
SF_bolt_act = mat_b.Sy / sig_bolt;

BCD      = 2*(R_outer + bolt_dia/2 + 0.015);
t_flange = max(1.5*bolt_dia, t_cap_nom);
t_fl_nom = ceil(t_flange*2000)/2000;

fprintf('=========================================================\n');
fprintf('  D) FLANGE & BOLT SIZING\n');
fprintf('=========================================================\n');
fprintf('Purpose: the flange/bolt joint clamps the gasket to seal the\n');
fprintf('vessel and captures the SiC plate on its shoulders. At this\n');
fprintf('operating pressure, gasket seating load typically exceeds the\n');
fprintf('pressure-driven separating load, so the bolts are usually sized\n');
fprintf('by SEALING, not by pressure containment.\n\n');
fprintf('Governing load            : %s\n', governs);
fprintf('  Gasket seating load     : %.2f N\n', W_seat);
fprintf('  Operating bolt load     : %.4f N\n', W_op);
fprintf('  Design bolt load        : %.2f N\n\n', W_bolts);
fprintf('Bolt: %s, dia = %.0f mm\n', mat_b.name, bolt_dia*1e3);
fprintf('Nominal bolt count  ★     : %d  (×4 symmetry)  ← USE THIS\n', n_nom);
fprintf('Bolt circle dia  ★        : %.1f mm  ← USE THIS\n', BCD*1e3);
fprintf('Flange thickness  ★       : %.1f mm  ← USE THIS\n', t_fl_nom*1e3);
fprintf('Bolt stress               : %.4f MPa\n', sig_bolt/1e6);
fprintf('SF (bolts)                : %.2f×  %s\n\n', SF_bolt_act, pass_fail(SF_bolt_act>=SF_bolt));

%% ===================================================================
%  E) MECHANICAL BC SUMMARY
%% ===================================================================

fprintf('=========================================================\n');
fprintf('  E) FEA — BOUNDARY CONDITIONS (pressure-only structural)\n');
fprintf('=========================================================\n\n');
fprintf('--- GEOMETRY ★ ---\n');
fprintf('  Inner radius          : %.1f mm\n', R_inner*1e3);
fprintf('  Wall thickness        : %.1f mm\n', t_wall_nom*1e3);
fprintf('  Outer radius          : %.1f mm\n', R_outer*1e3);
fprintf('  Vessel length         : %.0f mm\n', L_vessel*1e3);
fprintf('  End cap thickness     : %.1f mm  (%s)\n', t_cap_nom*1e3, endcap_type);
fprintf('  SiC plate thickness   : %.0f mm\n', t_SiC_nom*1e3);
fprintf('  Flange thickness      : %.1f mm\n', t_fl_nom*1e3);
fprintf('  Bolt circle dia       : %.1f mm\n', BCD*1e3);
fprintf('  No. bolts             : %d × M%.0f\n\n', n_nom, bolt_dia*1e3);
fprintf('--- ANALYSIS TYPE ---\n');
fprintf('  Static Structural, pressure-only \n');
fprintf('  Large deflection      : OFF  (w/t = %.6f << 0.2)\n\n', w_max/t_SiC_nom);
fprintf('--- PRESSURE BCs ---\n');
fprintf('  All inner surfaces    : %.0f Pa  (inward normal)\n', P_operating);
fprintf('  SiC top face          : %.0f Pa  (Galinstan side, downward)\n', P_operating);
fprintf('  SiC bottom face       : %.0f Pa  (N₂ side, upward)\n', P_operating);
fprintf('  Net ΔP across SiC     : %.0f Pa\n\n', P_operating);
fprintf('--- CONTACTS ---\n');
fprintf('  SiC-to-shoulder (both sides) : Frictional, μ = 0.3, allow separation\n');
fprintf('  SiC OD-to-bore               : radial clearance gap — no contact\n');
fprintf('                                  expected at assembly (floating plate)\n');
fprintf('  Gasket                       : INTER195 gasket element\n');
fprintf('  Bolt preload                 : PRETS179, %.0f MPa (80%% bolt yield)\n', 0.8*mat_b.Sy/1e6);
fprintf('  Welds                        : Bonded contact\n\n');
fprintf('--- ELEMENTS ---\n');
fprintf('  Vessel / end cap      : SOLID186  (20-node quadratic hex)\n');
fprintf('  SiC plate             : SOLID186  (t/R=%.2f, solid preferred)\n', t_SiC_nom/a_plate);
fprintf('  Gasket                : INTER195\n');
fprintf('  Contacts              : CONTA174 / TARGE170\n\n');
fprintf('--- MESH TARGETS ---\n');
fprintf('  Vessel wall           : %.2f mm  (≥3 elements through thickness)\n', t_wall_nom/3*1e3);
fprintf('  SiC plate             : %.2f mm  (≥5 elements through thickness)\n', t_SiC_nom/5*1e3);
fprintf('  Convergence: re-run at 0.75× mesh; accept if Δσ < 5%%\n\n');
fprintf('--- KEY RESULT PROBES ---\n');
fprintf('  1. Max principal stress    — SiC plate (brittle fracture criterion)\n');
fprintf('  2. Equivalent VM stress    — vessel inner wall\n');
fprintf('  3. Contact pressure        — SiC/shoulder (retention/seal integrity)\n');
fprintf('  4. Directional deformation — SiC plate centre\n');
fprintf('  5. SF contour (SiC vs MOR, vessel vs Sy)\n\n');
fprintf('--- OUT OF SCOPE FOR THIS HAND-CALC (recommend separately) ---\n');
fprintf('  - Bolt preload / joint-stiffness diagram across the operating\n');
fprintf('    ΔT range, to confirm clamp force never drops to zero or\n');
fprintf('    overstresses the SiC in compression on cooldown.\n');
fprintf('  - Confirm required as-built one-sided gap and how much it is\n');
fprintf('    expected to close/open across the full temperature range.\n\n');
fprintf('--- HAND-CALC VALIDATION TARGETS ---\n');
fprintf('  Vessel hoop (pressure)       : %.5f MPa\n', sig_hoop/1e6);
fprintf('  SiC bending stress           : %.4f MPa\n', sig_bend_nom/1e6);
fprintf('  SiC max deflection           : %.6f mm\n', w_max*1e3);
fprintf('  FEA agree within 5–10%% expected; larger → check mesh or BCs\n\n');

%% ===================================================================
%  FINAL SUMMARY TABLE
%% ===================================================================

fprintf('=========================================================\n');
fprintf('  FINAL SIZING SUMMARY  (★ = dimensions to enter in CAD/FEA)\n');
fprintf('=========================================================\n');
fprintf('%-44s %8s  %6s\n','Parameter','Value','Units');
fprintf('%s\n', repmat('-',1,62));
fprintf('%-44s %8.0f  %6s\n','Operating pressure',            P_operating,      'Pa');
fprintf('%-44s %8.0f  %6s\n','Operating temperature',         T_operating,      'degC');
fprintf('%s\n', repmat('-',1,62));
fprintf('%-44s %8.1f  %6s\n','★ Wall thickness',               t_wall_nom*1e3,  'mm');
fprintf('%-44s %8.1f  %6s\n','★ End cap thickness',            t_cap_nom*1e3,   'mm');
fprintf('%-44s %8.0f  %6s\n','★ SiC plate thickness',          t_SiC_nom*1e3,   'mm');
fprintf('%-44s %8.1f  %6s\n','★ Flange thickness',             t_fl_nom*1e3,    'mm');
fprintf('%-44s %8.1f  %6s\n','★ Bolt circle diameter',         BCD*1e3,         'mm');
fprintf('%-44s %8d  %6s\n',  '★ Number of bolts',              n_nom,           '-');
fprintf('%s\n', repmat('-',1,62));
fprintf('%-44s %8.5f  %6s\n','Vessel hoop stress (pressure)',  sig_hoop/1e6,    'MPa');
fprintf('%-44s %8.4f  %6s\n','SiC bending stress',             sig_bend_nom/1e6,'MPa');
fprintf('%-44s %8.6f  %6s\n','SiC max deflection',             w_max*1e3,       'mm');
fprintf('%-44s %8.3f  %6s\n','Critical flaw size (SiC)',       a_crit*1e3,      'mm');
fprintf('%s\n', repmat('-',1,62));
fprintf('%-44s %8.2f  %6s\n','SF: vessel (pressure)',          SF_wall_P,       '-');
fprintf('%-44s %8.2f  %6s\n','SF: SiC (bending)',              SF_SiC_bend,     '-');
fprintf('%-44s %8.2f  %6s\n','SF: bolts',                      SF_bolt_act,     '-');
fprintf('%s\n\n', repmat('-',1,62));
fprintf('=== SIZING COMPLETE ===\n');

%% ===================================================================
%  PARAMETRIC PLOTS
%% ===================================================================

figure('Position',[50 50 1300 850],'Name','Vessel Sizing — Parametric (Pressure-Only)');
colors = lines(4); SF_sweep = [2 3 4 5];

% Plot 1: SiC thickness vs plate radius, sweep SFs (pressure-only bending)
subplot(2,2,1); hold on;
R_range = linspace(0.010, 0.080, 120);
for k = 1:4
    sa = mat_s.MOR/SF_sweep(k);
    if strcmp(SiC_edge_BC,'clamped')
        ts = R_range .* sqrt(3*P_operating ./ (4*sa));
    else
        ts = R_range .* sqrt(3*(3+mat_s.nu)*P_operating ./ (8*sa));
    end
    plot(R_range*1e3, ts*1e3,'Color',colors(k,:),'LineWidth',1.8, ...
         'DisplayName',sprintf('SF=%.0f',SF_sweep(k)));
end
plot(a_plate*1e3, t_SiC_nom*1e3,'ko','MarkerSize',9,'LineWidth',2,'DisplayName','Current design');
grid on;
xlabel('Plate Radius [mm]'); ylabel('SiC Thickness [mm]');
title(sprintf('SiC Sizing — Pressure Bending Only (%s edge)',upper(SiC_edge_BC)));
legend('Location','best','FontSize',7);

% Plot 2: Stress budget bar (MOR -> allowable -> actual)
subplot(2,2,2)
bv = [mat_s.MOR, S_allow_SiC, sig_bend_nom]/1e6;
bc = [0.4 0.6 0.9; 0.2 0.7 0.4; 0.8 0.2 0.2];
bl = {'MOR','÷SF → allowable','Actual bending'};
b2 = bar(bv,'FaceColor','flat'); b2.CData = bc;
set(gca,'XTickLabel',bl,'XTickLabelRotation',15,'FontSize',9);
ylabel('Stress [MPa]'); title('SiC Stress Budget (pressure only)');
grid on;
for i=1:length(bv)
    text(i,bv(i)+1,sprintf('%.1f',bv(i)),'HorizontalAlignment','center','FontSize',8);
end

% Plot 3: SiC SF vs thickness (bending only)
subplot(2,2,3)
if strcmp(SiC_edge_BC,'clamped')
    C_b = (3*P_operating*a_plate^2)/4;
else
    C_b = (3*(3+mat_s.nu)*P_operating*a_plate^2)/8;
end
t_range = linspace(0.003, 0.030, 150);
SF_b_r = mat_s.MOR ./ (C_b./t_range.^2);
plot(t_range*1e3, SF_b_r,'b-','LineWidth',2,'DisplayName','Bending (pressure only)'); hold on;
yline(SF_SiC,'k--',sprintf('Target SF=%.0f',SF_SiC),'LineWidth',1.5,'LabelHorizontalAlignment','left');
plot(t_SiC_nom*1e3, SF_SiC_bend,'bo','MarkerSize',8,'LineWidth',2,'DisplayName','Current design');
grid on; ylim([0 min(30,max(SF_b_r)*1.1)]);
xlabel('SiC Plate Thickness [mm]'); ylabel('Safety Factor vs MOR');
title('SiC SF vs Thickness');
legend('Location','best','FontSize',8);

% Plot 4: Vessel wall SF vs operating pressure sweep
subplot(2,2,4)
P_range = linspace(500, 50000, 150);
sig_hoop_r  = P_range * R_inner / t_wall_nom;
sig_axial_r = P_range * R_inner / (2*t_wall_nom);
sig_vm_r    = sqrt(sig_hoop_r.^2 + sig_axial_r.^2 - sig_hoop_r.*sig_axial_r);
SF_wall_r   = mat_v.Sy ./ sig_vm_r;
plot(P_range, SF_wall_r,'m-','LineWidth',2); hold on;
yline(SF_vessel,'k--',sprintf('Target SF=%.0f',SF_vessel),'LineWidth',1.5,'LabelHorizontalAlignment','left');
xline(P_operating,'r--',sprintf('%.0f Pa (design)',P_operating),'LineWidth',1.2);
plot(P_operating, SF_wall_P,'mo','MarkerSize',8,'LineWidth',2);
grid on;
xlabel('Operating Pressure [Pa]'); ylabel('Vessel Wall SF (von Mises)');
title(sprintf('Vessel Wall SF vs Pressure (t_{wall}=%.1f mm, fixed)', t_wall_nom*1e3));

sgtitle(sprintf('Vessel Sizing — Pressure-Only | R_{in}=%.0fmm, P=%.0f Pa, T=%.0f°C', ...
        R_inner*1e3, P_operating, T_operating), ...
        'FontSize',10,'FontWeight','bold');

