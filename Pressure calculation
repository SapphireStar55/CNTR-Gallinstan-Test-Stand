%% Gallinstan Seepage Prevention and Gas Bubbling Pressure Calculator
% Calculates required pressure differential across porous SiC plate
% to prevent Gallinstan seepage while bubbling nitrogen gas through
%
% PROPERTY VALUES CORRECTED vs literature (see gallinstan_input_validation.m):
%   gamma_gallinstan : 0.65 → 0.535 N/m  (Plevachuk 2014, EGaInSn at 200°C)
%   rho_galinstan    : 6360 → 6332 kg/m³  (6440 at 20°C, dρ/dT = -0.6 kg/m³/K)
%   mu_nitrogen      : 2.5e-5 → 2.57e-5 Pa·s  (NIST at 200°C)
%   rho_nitrogen     : 0.746 → 0.745 kg/m³  (ideal gas, NIST)
%   alpha_vessel     : 17e-6 → 17.2e-6 1/K
%
% UNCERTAINTY BANDS added for γ (dominant uncertainty source):
%   gamma_nom  = 0.535 N/m  (oxide-free EGaInSn at 200°C)
%   gamma_low  = 0.400 N/m  (conservative — partial Ga₂O₃ oxidation present)
%   gamma_high = 0.590 N/m  (upper bound — fully inert, RT brand value)
%
% MATERIAL COMPATIBILITY WARNING:
%   316L SS is partially attacked by Ga alloys via liquid metal embrittlement.
%   Consider SiC-lined or PTFE-lined vessel, or Hastelloy C-276.

% =========================================================================
clear; clc; close all;

%% ===== INPUT PARAMETERS =====

% SiC Plate Properties
pore_diameter    = 1000e-6;      % Pore diameter [m] (1000 microns)
plate_thickness  = 20e-3;        % Plate thickness [m] (20 mm)
porosity         = 0.2475;       % Porosity [-]
active_area      = 1e-4;         % Active flow area [m^2] (1 cm^2)

% Operating Conditions
flow_rate_cm3s   = 5;            % Nitrogen flow rate [cm^3/s]
temperature_C    = 200;          % Operating temperature [°C]
gas_type         = 'nitrogen';   % Gas type (informational)

% Vessel Geometry
gallinstan_height = 0.05;        % Height of Gallinstan above SiC plate [m]

%% ===== MATERIAL PROPERTIES  (literature-validated) =====

T_K = temperature_C + 273.15;   % [K]

% ------------------------------------------------------------------
% Gallinstan at 200°C
% Surface tension: γ(T) = 587 - 0.0109*(T_K - 283.15) mN/m
%   Plevachuk et al. (2014) J. Chem. Eng. Data 59, 757 — EGaInSn
%   Brand Galinstan(R) ~534 mN/m at RT (Handschuh-Wang 2022)
% Three scenarios to bracket oxidation uncertainty:
% ------------------------------------------------------------------
gamma_nom  = (587 - 0.0109*(T_K - 283.15)) * 1e-3;  % [N/m] oxide-free EGaInSn
gamma_low  = 0.400;                                   % [N/m] partial oxidation worst-case
gamma_high = 0.590;                                   % [N/m] upper bound (brand RT value)
gamma_gallinstan = gamma_nom;                         % ← NOMINAL used in all calculations

% Density: 6440 kg/m³ at 20°C, dρ/dT ≈ -0.60 kg/m³/K (liquid metal typical)
rho_gallinstan = 6440 + (-0.60) * (temperature_C - 20);  % [kg/m³] at 200°C

% Contact angles (non-wetting on clean SiC in inert atmosphere)
contact_angle_adv_deg = 145;    % Advancing [°] — used for seepage calc (worst case entry)
contact_angle_rec_deg = 120;    % Receding  [°] — lower bound once Ga has entered pore

% ------------------------------------------------------------------
% Nitrogen at 200°C, 1 atm  (NIST reference data)
% ------------------------------------------------------------------
mu_nitrogen  = 2.57e-5;         % Dynamic viscosity [Pa·s]  NIST 473 K
rho_nitrogen = (101325 * 0.028014) / (8.314 * T_K);  % Ideal gas [kg/m³] = 0.7448

% Mean free path of N2 at 200°C, 1 atm (kinetic theory)
lambda_mfp   = 70e-9;           % [m]

% SiC / Vessel Thermal Properties
alpha_SiC     = 4.0e-6;         % CTE of SiC [1/K]       (sintered α-SiC)
alpha_vessel  = 17.2e-6;        % CTE of 316L SS [1/K]   (ASME IID at 200°C)
E_SiC         = 410e9;          % Young's modulus SiC [Pa]
delta_T       = temperature_C - 20;  % Temperature rise from assembly temp [K]

% Universal constants
g = 9.81;                        % [m/s^2]

%% ===== PRINT PROPERTY VALUES WITH SOURCE NOTES =====

fprintf('=== MATERIAL PROPERTIES (literature-corrected) ===\n');
fprintf('Gallinstan surface tension:\n');
fprintf('  γ_nominal  (oxide-free EGaInSn, 200°C) : %.4f N/m  [Plevachuk 2014]\n', gamma_nom);
fprintf('  γ_low      (partial Ga₂O₃ oxidation)   : %.4f N/m  [conservative]\n', gamma_low);
fprintf('  γ_high     (upper bound, brand RT)      : %.4f N/m  [Handschuh-Wang 2022]\n', gamma_high);
fprintf('  *** Calculations use γ_nominal = %.4f N/m ***\n', gamma_gallinstan);
fprintf('  NOTE: ensure N₂ supply has <10 ppm O₂ to stay near γ_nominal.\n');
fprintf('        If O₂ uncontrolled, use γ_low for conservative design.\n\n');
fprintf('Gallinstan density at %.0f°C : %.1f kg/m³\n', temperature_C, rho_gallinstan);
fprintf('  (extrapolated from 6440 kg/m³ at 20°C, dρ/dT = -0.60 kg/m³/K)\n\n');
fprintf('N₂ viscosity  at %.0f°C, 1 atm : %.3e Pa·s  [NIST]\n', temperature_C, mu_nitrogen);
fprintf('N₂ density    at %.0f°C, 1 atm : %.4f kg/m³  [ideal gas]\n\n', temperature_C, rho_nitrogen);
fprintf('⚠  MATERIAL COMPATIBILITY WARNING:\n');
fprintf('   Gallium alloys attack most metals via liquid metal embrittlement (LME).\n');
fprintf('   316L SS has limited resistance; Ga can diffuse along grain boundaries\n');
fprintf('   at 200°C. Consider: SiC-lined vessel, PTFE liner, or Hastelloy C-276.\n');
fprintf('   Tungsten and molybdenum are the most resistant structural metals.\n\n');

%% ===== DERIVED PARAMETERS =====

pore_radius             = pore_diameter / 2;
contact_angle_adv_rad   = deg2rad(contact_angle_adv_deg);
contact_angle_rec_rad   = deg2rad(contact_angle_rec_deg);
flow_rate_m3s           = flow_rate_cm3s * 1e-6;
superficial_velocity    = flow_rate_m3s / active_area;

%% ===== PERMEABILITY (Kozeny-Carman) =====

kozeny_constant = 180;
permeability = (porosity^3 * pore_diameter^2) / ...
               (kozeny_constant * (1 - porosity)^2);

Sphericity   = 250e-9;
diameter_abs = 1e-6;
absperm = (Sphericity^2 * porosity^3 * diameter_abs^2) / ...
          (150 * (1 - porosity)^2);

%% ===== DIMENSIONLESS SANITY CHECKS =====

Re_pore = rho_nitrogen * superficial_velocity * pore_diameter / mu_nitrogen;
Ca      = mu_nitrogen * superficial_velocity / gamma_gallinstan;
Kn      = lambda_mfp / pore_radius;

fprintf('=== DIMENSIONLESS CHECKS ===\n');
fprintf('Pore Reynolds number : %.5f  (Darcy valid if Re << 1)\n', Re_pore);
fprintf('Capillary number     : %.2e  (capillary-dominated if Ca << 1)\n', Ca);
fprintf('Knudsen number       : %.2e  (continuum OK if Kn << 0.01)\n\n', Kn);

if Re_pore > 1
    warning('Re_pore > 1: Forchheimer inertial correction is significant.');
end
if Kn > 0.01
    warning('Kn > 0.01: Klinkenberg slip-flow correction applied below.');
end

%% ===== KLINKENBERG SLIP-FLOW CORRECTION =====

b_klink = 0.11 * permeability^(-0.39);
P_mean  = 101325;
k_klink = permeability * (1 + b_klink / P_mean);

fprintf('=== KLINKENBERG SLIP CORRECTION ===\n');
fprintf('Intrinsic permeability   : %.3e m²\n', permeability);
fprintf('Klinkenberg factor b     : %.4f Pa\n',  b_klink);
fprintf('Slip-corrected perm.     : %.3e m²\n\n', k_klink);

%% ===== SYSTEM PARAMETERS PRINTOUT =====

fprintf('=== SYSTEM PARAMETERS ===\n');
fprintf('Pore diameter        : %.1f μm\n',    pore_diameter*1e6);
fprintf('Plate thickness      : %.1f mm\n',    plate_thickness*1e3);
fprintf('Porosity             : %.2f%%\n',     porosity*100);
fprintf('Active area          : %.2f cm²\n',   active_area*1e4);
fprintf('Flow rate            : %.2f cm³/s\n', flow_rate_cm3s);
fprintf('Temperature          : %.0f°C\n',     temperature_C);
fprintf('Gallinstan height    : %.0f mm\n',    gallinstan_height*1e3);
fprintf('Est. permeability    : %.2e m²\n\n',  permeability);

%% ===== PRESSURE CALCULATIONS =====

% Hydrostatic (independent of gamma)
delta_P_hydrostatic = rho_gallinstan * g * gallinstan_height;

% --- Nominal (γ_nom) ---
delta_P_capillary_adv = (2*gamma_gallinstan*abs(cos(contact_angle_adv_rad))) / pore_radius;
delta_P_capillary_rec = (2*gamma_gallinstan*abs(cos(contact_angle_rec_rad))) / pore_radius;
delta_P_flow          = (mu_nitrogen * superficial_velocity * plate_thickness) / k_klink;
beta_forchheimer      = 1.75 / (sqrt(k_klink) * porosity^1.5);
delta_P_forchhei      = beta_forchheimer * rho_nitrogen * superficial_velocity^2 * plate_thickness;
delta_P_bubble        = (2*gamma_gallinstan) / pore_radius;
delta_P_total         = delta_P_capillary_adv + delta_P_hydrostatic + ...
                        delta_P_flow + delta_P_forchhei + delta_P_bubble;

% --- Low γ (oxidation worst-case) ---
dP_cap_adv_low = (2*gamma_low*abs(cos(contact_angle_adv_rad))) / pore_radius;
dP_bubble_low  = (2*gamma_low) / pore_radius;
delta_P_total_low = dP_cap_adv_low + delta_P_hydrostatic + ...
                    delta_P_flow + delta_P_forchhei + dP_bubble_low;

% --- High γ (fully inert upper bound) ---
dP_cap_adv_high = (2*gamma_high*abs(cos(contact_angle_adv_rad))) / pore_radius;
dP_bubble_high  = (2*gamma_high) / pore_radius;
delta_P_total_high = dP_cap_adv_high + delta_P_hydrostatic + ...
                     delta_P_flow + delta_P_forchhei + dP_bubble_high;

%% ===== RESULTS OUTPUT =====

fprintf('=== PRESSURE COMPONENTS (nominal γ = %.4f N/m) ===\n', gamma_gallinstan);

fprintf('1. Capillary Entry Pressure (advancing, θ=%.0f°):\n', contact_angle_adv_deg);
fprintf('   ΔP_cap_adv = %8.1f Pa  (%.5f bar, %.4f psi)\n', ...
        delta_P_capillary_adv, delta_P_capillary_adv/1e5, delta_P_capillary_adv/6894.76);
fprintf('   Capillary pressure (receding, θ=%.0f°, hysteresis lower bound):\n', contact_angle_rec_deg);
fprintf('   ΔP_cap_rec = %8.1f Pa  (%.5f bar, %.4f psi)\n\n', ...
        delta_P_capillary_rec, delta_P_capillary_rec/1e5, delta_P_capillary_rec/6894.76);

fprintf('2. Hydrostatic Head (%.0f mm Galinstan, ρ=%.0f kg/m³):\n', ...
        gallinstan_height*1e3, rho_gallinstan);
fprintf('   ΔP_hydro   = %8.1f Pa  (%.5f bar, %.4f psi)\n\n', ...
        delta_P_hydrostatic, delta_P_hydrostatic/1e5, delta_P_hydrostatic/6894.76);

fprintf('3. Viscous Flow Resistance (Darcy + Klinkenberg):\n');
fprintf('   ΔP_flow    = %8.4f Pa  (%.7f bar)\n\n', ...
        delta_P_flow, delta_P_flow/1e5);

fprintf('4. Forchheimer Inertial Correction:\n');
fprintf('   ΔP_Forch   = %8.6f Pa  (negligible at this flow rate)\n\n', delta_P_forchhei);

fprintf('5. Bubble Formation Pressure (Young-Laplace):\n');
fprintf('   ΔP_bubble  = %8.1f Pa  (%.5f bar, %.4f psi)\n\n', ...
        delta_P_bubble, delta_P_bubble/1e5, delta_P_bubble/6894.76);

fprintf('=== TOTAL REQUIRED PRESSURE — UNCERTAINTY RANGE ===\n');
fprintf('  γ_low  (%.3f N/m, oxidised)  : %8.1f Pa  (%.5f bar)  ← minimum credible\n', ...
        gamma_low,  delta_P_total_low,  delta_P_total_low/1e5);
fprintf('  γ_nom  (%.3f N/m, oxide-free): %8.1f Pa  (%.5f bar)  ← DESIGN VALUE\n', ...
        gamma_gallinstan, delta_P_total, delta_P_total/1e5);
fprintf('  γ_high (%.3f N/m, upper)     : %8.1f Pa  (%.5f bar)  ← upper bound\n\n', ...
        gamma_high, delta_P_total_high, delta_P_total_high/1e5);

fprintf('  ΔP_total (nominal) = %.1f Pa = %.5f bar = %.4f psi = %.5f atm\n\n', ...
        delta_P_total, delta_P_total/1e5, delta_P_total/6894.76, delta_P_total/101325);

fprintf('INTERPRETATION:\n');
fprintf('  Gas pressure below SiC must exceed pressure above by %.1f Pa (nominal)\n', delta_P_total);
fprintf('  to simultaneously:\n');
fprintf('    ✓ Overcome capillary entry pressure (seepage prevention)\n');
fprintf('    ✓ Support %.0f mm hydrostatic head of Galinstan\n', gallinstan_height*1e3);
fprintf('    ✓ Push N₂ through pores (viscous + inertial losses)\n');
fprintf('    ✓ Form bubbles in Galinstan (Young-Laplace)\n');
fprintf('  If O₂ contamination is present (γ drops to %.3f N/m),\n', gamma_low);
fprintf('  required ΔP drops to %.1f Pa — capillary barrier weakens.\n', delta_P_total_low);
fprintf('  RISK: if θ < 90° due to oxidation, capillary barrier disappears entirely.\n\n');

%% ===== COMPONENT BREAKDOWN =====

fprintf('=== COMPONENT BREAKDOWN (nominal) ===\n');
fprintf('Capillary (adv.) :  %5.1f%% of total\n', 100*delta_P_capillary_adv/delta_P_total);
fprintf('Hydrostatic      :  %5.1f%% of total\n', 100*delta_P_hydrostatic/delta_P_total);
fprintf('Flow (Darcy)     :  %5.1f%% of total\n', 100*delta_P_flow/delta_P_total);
fprintf('Forchheimer      :  %5.1f%% of total\n', 100*delta_P_forchhei/delta_P_total);
fprintf('Bubble formation :  %5.1f%% of total\n\n', 100*delta_P_bubble/delta_P_total);

%% ===== BUBBLE CHARACTERISTICS =====

D_fritz = 0.0208 * contact_angle_adv_deg * ...
          sqrt(gamma_gallinstan / (g * (rho_gallinstan - rho_nitrogen)));
R_fritz = D_fritz / 2;
bubble_volume_pore  = (4/3)*pi*pore_radius^3;
bubble_volume_fritz = (4/3)*pi*R_fritz^3;
bubble_freq_pore    = flow_rate_m3s / bubble_volume_pore;
bubble_freq_fritz   = flow_rate_m3s / bubble_volume_fritz;

fprintf('=== BUBBLE CHARACTERISTICS ===\n');
fprintf('Pore-radius model:\n');
fprintf('  Bubble radius    : %.1f μm\n', pore_radius*1e6);
fprintf('  Bubble frequency : %.2f Hz  (%.0f bubbles/min)\n', bubble_freq_pore, bubble_freq_pore*60);
fprintf('Fritz detachment model:\n');
fprintf('  Detachment diameter : %.2f mm\n', D_fritz*1e3);
fprintf('  Bubble frequency    : %.4f Hz  (%.2f bubbles/min)\n', bubble_freq_fritz, bubble_freq_fritz*60);
fprintf('(Actual bubbles will coalesce and grow; Fritz gives detachment upper bound on size)\n\n');

%% ===== THERMAL STRESS ESTIMATE =====

delta_alpha   = abs(alpha_SiC - alpha_vessel);
sigma_thermal = E_SiC * delta_alpha * delta_T;

fprintf('=== THERMAL STRESS ESTIMATE ===\n');
fprintf('α_SiC    : %.1f μm/m·K\n', alpha_SiC*1e6);
fprintf('α_vessel : %.1f μm/m·K  (316L SS, corrected)\n', alpha_vessel*1e6);
fprintf('ΔCTE     : %.1f μm/m·K\n', delta_alpha*1e6);
fprintf('ΔT       : %.0f K  (20°C assembly → %.0f°C operating)\n', delta_T, temperature_C);
fprintf('Est. biaxial stress in SiC : %.1f MPa\n', sigma_thermal/1e6);
fprintf('SiC MOR (sintered α-SiC)   : 300–500 MPa\n');
if sigma_thermal > 300e6
    fprintf('⚠  WARNING: Thermal stress may approach SiC MOR lower bound.\n');
    fprintf('   Review clamping, add compliant interlayer (graphite or PTFE), or\n');
    fprintf('   use a floating plate design to allow free thermal expansion.\n\n');
else
    fprintf('✓  Thermal stress within acceptable range for sintered SiC.\n\n');
end

%% ===== PARAMETRIC STUDY: EFFECT OF PORE SIZE =====

pore_diameters = logspace(-5, -4, 50);
n = length(pore_diameters);
P_cap_array   = zeros(1,n);  P_hydro_array = zeros(1,n);
P_flow_array  = zeros(1,n);  P_forch_array = zeros(1,n);
P_bubble_array= zeros(1,n);  P_total_array = zeros(1,n);
P_total_low   = zeros(1,n);  P_total_high  = zeros(1,n);

for i = 1:n
    d   = pore_diameters(i);
    r   = d/2;
    k   = (porosity^3*d^2) / (kozeny_constant*(1-porosity)^2);
    b_k = 0.11*k^(-0.39);
    k_kl= k*(1+b_k/P_mean);

    P_cap_array(i)    = (2*gamma_gallinstan*abs(cos(contact_angle_adv_rad))) / r;
    P_hydro_array(i)  = delta_P_hydrostatic;
    P_flow_array(i)   = (mu_nitrogen*superficial_velocity*plate_thickness) / k_kl;
    beta_f            = 1.75/(sqrt(k_kl)*porosity^1.5);
    P_forch_array(i)  = beta_f*rho_nitrogen*superficial_velocity^2*plate_thickness;
    P_bubble_array(i) = (2*gamma_gallinstan) / r;
    P_total_array(i)  = P_cap_array(i)+P_hydro_array(i)+P_flow_array(i)+...
                        P_forch_array(i)+P_bubble_array(i);

    % Uncertainty bands
    P_total_low(i)  = (2*gamma_low*abs(cos(contact_angle_adv_rad)))/r + ...
                      P_hydro_array(i) + P_flow_array(i) + P_forch_array(i) + (2*gamma_low)/r;
    P_total_high(i) = (2*gamma_high*abs(cos(contact_angle_adv_rad)))/r + ...
                      P_hydro_array(i) + P_flow_array(i) + P_forch_array(i) + (2*gamma_high)/r;
end

%% ===== PLOTS =====

figure('Position',[100 100 1150 850],'Name','Gallinstan Pressure Analysis (Corrected Properties)');

% --- Panel 1: Absolute pressures with uncertainty band ---
subplot(2,2,1)
patch([pore_diameters pore_diameters(end:-1:1)]*1e6, ...
      [P_total_low P_total_high(end:-1:1)]/1e5, ...
      [0.7 0.85 1.0],'EdgeColor','none','FaceAlpha',0.4,'DisplayName','γ uncertainty band');
hold on;
loglog(pore_diameters*1e6, P_total_array/1e5,  'b-',  'LineWidth',2,   'DisplayName','Total (γ_{nom})');
loglog(pore_diameters*1e6, P_cap_array/1e5,    'r--', 'LineWidth',1.5, 'DisplayName','Capillary');
loglog(pore_diameters*1e6, P_bubble_array/1e5, 'g--', 'LineWidth',1.5, 'DisplayName','Bubble');
loglog(pore_diameters*1e6, P_flow_array/1e5,   'm--', 'LineWidth',1.5, 'DisplayName','Darcy Flow');
loglog(pore_diameters*1e6, P_hydro_array/1e5,  'k:',  'LineWidth',1.5, 'DisplayName','Hydrostatic');
loglog(pore_diameter*1e6,  delta_P_total/1e5,  'ko',  'MarkerSize',10, 'LineWidth',2,'DisplayName','Op. Point');
set(gca,'XScale','log','YScale','log');
grid on; grid minor;
xlabel('Pore Diameter [μm]'); ylabel('Pressure [bar]');
title('Required Pressure vs Pore Size');
legend('Location','best','FontSize',7);

% --- Panel 2: Component contributions ---
subplot(2,2,2)
semilogx(pore_diameters*1e6, 100*P_cap_array./P_total_array,    'r-',  'LineWidth',1.5,'DisplayName','Capillary'); hold on;
semilogx(pore_diameters*1e6, 100*P_bubble_array./P_total_array, 'g-',  'LineWidth',1.5,'DisplayName','Bubble');
semilogx(pore_diameters*1e6, 100*P_flow_array./P_total_array,   'm-',  'LineWidth',1.5,'DisplayName','Darcy');
semilogx(pore_diameters*1e6, 100*P_forch_array./P_total_array,  'c-',  'LineWidth',1.5,'DisplayName','Forchheimer');
semilogx(pore_diameters*1e6, 100*P_hydro_array./P_total_array,  'k--', 'LineWidth',1.5,'DisplayName','Hydrostatic');
xline(pore_diameter*1e6,'k:','LineWidth',1,'Label','Op. Point');
grid on; ylim([0 100]);
xlabel('Pore Diameter [μm]'); ylabel('Contribution [%]');
title('Pressure Component Contributions');
legend('Location','best','FontSize',7);

% --- Panel 3: γ uncertainty effect on total pressure ---
subplot(2,2,3)
gamma_sweep = linspace(0.35, 0.65, 100);
dP_vs_gamma = zeros(size(gamma_sweep));
for j = 1:length(gamma_sweep)
    gj = gamma_sweep(j);
    dP_vs_gamma(j) = (2*gj*abs(cos(contact_angle_adv_rad)))/pore_radius + ...
                     delta_P_hydrostatic + delta_P_flow + delta_P_forchhei + ...
                     (2*gj)/pore_radius;
end
plot(gamma_sweep*1e3, dP_vs_gamma, 'b-', 'LineWidth', 2); hold on;
xline(gamma_low*1e3,  'm--', sprintf('γ_{low}=%.0f mN/m', gamma_low*1e3),  'LineWidth',1.5,'LabelVerticalAlignment','bottom');
xline(gamma_nom*1e3,  'g--', sprintf('γ_{nom}=%.0f mN/m', gamma_nom*1e3),  'LineWidth',1.5,'LabelVerticalAlignment','top');
xline(gamma_high*1e3, 'r--', sprintf('γ_{high}=%.0f mN/m',gamma_high*1e3), 'LineWidth',1.5,'LabelVerticalAlignment','bottom');
plot(gamma_gallinstan*1e3, delta_P_total, 'ko', 'MarkerSize',8,'LineWidth',2,'DisplayName','Design point');
grid on;
xlabel('Surface Tension γ [mN/m]'); ylabel('Total ΔP [Pa]');
title('Sensitivity to γ (dominant uncertainty)');
legend('ΔP total','Location','best','FontSize',8);

% --- Panel 4: Flow rate sensitivity ---
subplot(2,2,4)
flow_rates = linspace(0.1, 20, 100);
P_vs_flow  = zeros(size(flow_rates));
for j = 1:length(flow_rates)
    v_j      = (flow_rates(j)*1e-6) / active_area;
    dP_fl_j  = (mu_nitrogen*v_j*plate_thickness) / k_klink;
    beta_j   = 1.75/(sqrt(k_klink)*porosity^1.5);
    dP_fo_j  = beta_j*rho_nitrogen*v_j^2*plate_thickness;
    P_vs_flow(j) = delta_P_capillary_adv + delta_P_hydrostatic + dP_fl_j + dP_fo_j + delta_P_bubble;
end
plot(flow_rates, P_vs_flow, 'b-', 'LineWidth',2); hold on;
plot(flow_rate_cm3s, delta_P_total, 'ro', 'MarkerSize',8,'LineWidth',2);
grid on;
xlabel('N₂ Flow Rate [cm³/s]'); ylabel('Total Required ΔP [Pa]');
title('Sensitivity to N₂ Flow Rate');
legend('Total ΔP','Current op. point','Location','best');

sgtitle(sprintf('Gallinstan/SiC Bubbler — Corrected Properties (γ_{nom}=%.0f mN/m, ρ=%.0f kg/m³, T=%.0f°C)', ...
        gamma_nom*1e3, rho_gallinstan, temperature_C), 'FontSize',11,'FontWeight','bold');

fprintf('=== CALCULATION COMPLETE ===\n');
fprintf('Key correction: γ reduced from 0.650 to %.3f N/m (literature value at 200°C).\n', gamma_nom);
fprintf('Panel 3 shows how total ΔP varies across the full γ uncertainty range.\n');
fprintf('Red circles mark the current operating point.\n');
